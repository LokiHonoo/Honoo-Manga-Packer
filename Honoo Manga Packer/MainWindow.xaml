<hui:ChromeWindow
    x:Class="Honoo.MangaPacker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hui="https://github.com/lokihonoo/honooui.wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Honoo.MangaPacker.ViewModels"
    Title="Honoo Manga Packer"
    Left="{Binding Settings.WindowLeft, Mode=TwoWay}"
    ResizeMode="CanMinimize"
    SizeToContent="WidthAndHeight"
    SystemButtons="Minimize"
    Top="{Binding Settings.WindowTop, Mode=TwoWay}"
    Topmost="{Binding Settings.Topmost, Mode=TwoWay}"
    mc:Ignorable="d">
    <hui:ChromeWindow.Resources>
        <hui:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <hui:BooleanToVisibilityVisibleConverter x:Key="BooleanToVisibilityVisibleConverter" />
    </hui:ChromeWindow.Resources>
    <hui:ChromeWindow.DataContext>
        <vm:MainWindowViewModel />
    </hui:ChromeWindow.DataContext>
    <hui:ChromeWindow.SystemBar>
        <ToggleButton
            Margin="0,0,1,0"
            hui:ToggleButtonAttached.CheckedBackground="{DynamicResource PrimaryBackgroundWeak400Brush}"
            IsChecked="{Binding Settings.Topmost, Mode=TwoWay}"
            Style="{StaticResource ToggleButtonSystemBarStyle}"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <hui:CheckStateControl
                CheckedContent="{StaticResource PinFillGeometry}"
                CheckedContentTemplate="{StaticResource PathIcon16FillParentForegroundGeometryDataTemplate}"
                UncheckedContent="{StaticResource PinGeometry}"
                UncheckedContentTemplate="{StaticResource PathIcon16FillParentForegroundGeometryDataTemplate}" />
        </ToggleButton>
    </hui:ChromeWindow.SystemBar>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Image
                Width="20"
                Height="20"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Source="/Resources/yoriko18.ico"
                WindowChrome.IsHitTestVisibleInChrome="False" />
            <TextBlock
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentBrush}"
                Text="Honoo Manga Packer"
                WindowChrome.IsHitTestVisibleInChrome="False" />
            <TextBlock
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource ThirdlyForegroundBrush}"
                Text="{Binding Version}"
                WindowChrome.IsHitTestVisibleInChrome="False" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="300"
                    Height="140"
                    Margin="0,0,5,0"
                    AllowDrop="True"
                    Background="#FFCAE4B5"
                    CornerRadius="10">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Drop">
                            <b:InvokeCommandAction Command="{Binding UnpackDropCommand}" PassEventArgsToCommand="True" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="拖放 ZIP/RAR/7Z/PDF ..." />
                        <ProgressBar
                            Grid.Row="1"
                            Margin="70,0"
                            d:Visibility="Visible"
                            Background="Transparent"
                            Foreground="#FFFB9D4C"
                            IsIndeterminate="True"
                            Visibility="{Binding UnpackWorkbench.IsRunning, Converter={StaticResource BooleanToVisibilityVisibleConverter}, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="0"
                            FontFamily="/Resources/#LESLIE"
                            FontSize="32"
                            Text="{Binding UnpackWorkbench.Projects.Count, Mode=OneWay}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <hui:BooleanToCustomConverter
                                    x:Key="BooleanToCustumConverter"
                                    FalseValue="解 包"
                                    TrueValue="取 消" />
                            </Grid.Resources>
                            <ComboBox
                                Grid.Column="0"
                                Padding="7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding UnpackWorkbench.IsRunning, Converter={StaticResource BooleanReverseConverter}, Mode=OneWay}"
                                ItemsSource="{Binding Settings.UnpackEncodings}"
                                Text="{Binding Settings.UnpackEncoding, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Visibility="Visible"
                                Command="{Binding ViewUnpackLogCommand}"
                                Content="{StaticResource ExclamationGeometry}"
                                ContentTemplate="{StaticResource PathIcon16FillParentForegroundGeometryDataTemplate}"
                                Foreground="Red"
                                Style="{StaticResource ButtonTransparentStyle}"
                                Visibility="{Binding UnpackWorkbench.HasError, Converter={StaticResource BooleanToVisibilityVisibleConverter}, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Margin="5,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StressBrush}"
                                Command="{Binding UnpackClearCommand}"
                                Content="清除列表"
                                Foreground="{DynamicResource StressContentBrush}"
                                IsEnabled="{Binding UnpackWorkbench.IsRunning, Converter={StaticResource BooleanReverseConverter}, Mode=OneWay}" />
                            <Button
                                Grid.Column="3"
                                Margin="5,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                Command="{Binding UnpackCommand}"
                                Content="{Binding UnpackWorkbench.IsRunning, Converter={StaticResource BooleanToCustumConverter}, Mode=OneWay}"
                                Foreground="{DynamicResource AccentContentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Width="300"
                    Height="140"
                    Margin="5,0,0,0"
                    AllowDrop="True"
                    Background="#FFB0DFFD"
                    CornerRadius="10">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Drop">
                            <b:InvokeCommandAction Command="{Binding PackDropCommand}" PassEventArgsToCommand="True" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="拖放文件夹..." />
                        <ProgressBar
                            Grid.Row="1"
                            Margin="70,0"
                            d:Visibility="Visible"
                            Background="Transparent"
                            Foreground="#FFFB9D4C"
                            IsIndeterminate="True"
                            Visibility="{Binding PackWorkbench.IsRunning, Converter={StaticResource BooleanToVisibilityVisibleConverter}, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="0"
                            FontFamily="/Resources/#LESLIE"
                            FontSize="32"
                            Text="{Binding PackWorkbench.Projects.Count, Mode=OneWay}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <hui:BooleanToCustomConverter
                                    x:Key="BooleanToCustumConverter"
                                    FalseValue="打 包"
                                    TrueValue="取 消" />
                            </Grid.Resources>
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Visibility="Visible"
                                Command="{Binding ViewPackLogCommand}"
                                Content="{StaticResource ExclamationGeometry}"
                                ContentTemplate="{StaticResource PathIcon16FillParentForegroundGeometryDataTemplate}"
                                Foreground="Red"
                                Style="{StaticResource ButtonTransparentStyle}"
                                Visibility="{Binding PackWorkbench.HasError, Converter={StaticResource BooleanToVisibilityVisibleConverter}, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Margin="5,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StressBrush}"
                                Command="{Binding PackClearCommand}"
                                Content="清除列表"
                                Foreground="{DynamicResource StressContentBrush}"
                                IsEnabled="{Binding PackWorkbench.IsRunning, Converter={StaticResource BooleanReverseConverter}, Mode=OneWay}" />
                            <Button
                                Grid.Column="3"
                                Margin="5,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                Command="{Binding PackCommand}"
                                Content="{Binding PackWorkbench.IsRunning, Converter={StaticResource BooleanToCustumConverter}, Mode=OneWay}"
                                Foreground="{DynamicResource AccentContentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Expander
                Grid.Row="1"
                Margin="0,10,0,0"
                IsExpanded="{Binding Settings.SettingExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <StackPanel Margin="10,6,0,6" Orientation="Horizontal">
                        <Path Data="{StaticResource SettingGeometry}" Style="{StaticResource PathIcon16Style}" />
                        <TextBlock Margin="10,0,0,0" Text="设置" />
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.ColumnSpan="2">
                        <GroupBox.Header>
                            <TextBlock Margin="10,6,0,6" Text="通用设置" />
                        </GroupBox.Header>
                        <StackPanel Margin="10">
                            <hui:TextBoxEx IsReadOnly="True" Text="{Binding Settings.WorkDirectly, Mode=TwoWay}">
                                <hui:TextBoxEx.Header>
                                    <Border
                                        Margin="5,5,0,5"
                                        VerticalAlignment="Stretch"
                                        Background="#FFDEDEDE"
                                        CornerRadius="5">
                                        <TextBlock
                                            Margin="5,3"
                                            VerticalAlignment="Center"
                                            Text="工作文件夹" />
                                    </Border>
                                </hui:TextBoxEx.Header>
                                <hui:TextBoxEx.Footer>
                                    <Button
                                        Margin="5"
                                        Padding="3"
                                        Command="{Binding BrowserWorkDirectlyCommand}"
                                        Style="{StaticResource ButtonTransparentStyle}">
                                        <Path Data="{StaticResource FolderOpenGeometry}" Style="{StaticResource PathIcon16Style}" />
                                    </Button>
                                </hui:TextBoxEx.Footer>
                            </hui:TextBoxEx>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,10,5,0">
                        <GroupBox.Header>
                            <TextBlock Margin="10,6,0,6" Text="解包设置" />
                        </GroupBox.Header>
                        <StackPanel Margin="10">
                            <CheckBox
                                HorizontalAlignment="Left"
                                Content="任务开始前清理 工作文件夹/Unpacks"
                                IsChecked="{Binding Settings.UnpackClearTarget, Mode=TwoWay}" />
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="尝试使用密码" IsChecked="{Binding Settings.UnpackTryPassword, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="7,0"
                                    Command="{Binding EditPasswordsCommand}">
                                    <Path Data="{StaticResource MoreHorizontalGeometry}" Style="{StaticResource PathIcon16Style}" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="解包成功的项目加入打包列表" IsChecked="{Binding Settings.UnpackSendToPack, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="如果打包任务运行中不会添加">
                                    <Path
                                        Data="{StaticResource QuestionGeometry}"
                                        Fill="{DynamicResource AccentBrush}"
                                        Style="{StaticResource PathIcon14Style}" />
                                </Border>
                            </Grid>
                            <CheckBox
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Content="解包成功的项目源文件移入回收站"
                                IsChecked="{Binding Settings.UnpackDelSource, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5,10,0,0">
                        <GroupBox.Header>
                            <TextBlock Margin="10,6,0,6" Text="打包设置" />
                        </GroupBox.Header>
                        <StackPanel Margin="10">
                            <CheckBox
                                HorizontalAlignment="Left"
                                Content="任务开始前清理 工作文件夹/Packs"
                                IsChecked="{Binding Settings.PackClearTarget, Mode=TwoWay}" />
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Content="移除广告页"
                                    IsChecked="{Binding Settings.PackRemoveAD, Mode=TwoWay}"
                                    IsEnabled="False" />
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="匹配广告列表文件，此选项会影响打包速度">
                                    <Path
                                        Data="{StaticResource QuestionGeometry}"
                                        Fill="{DynamicResource AccentBrush}"
                                        Style="{StaticResource PathIcon14Style}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="移除嵌套文件夹" IsChecked="{Binding Settings.PackRemoveNest, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="并将最长的名称作为项目文件名称">
                                    <Path
                                        Data="{StaticResource QuestionGeometry}"
                                        Fill="{DynamicResource AccentBrush}"
                                        Style="{StaticResource PathIcon14Style}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="添加项目名称文件夹" IsChecked="{Binding Settings.PackAddNest, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="在打包文件中添加一层嵌套的和文件名同名的文件夹">
                                    <Path
                                        Data="{StaticResource QuestionGeometry}"
                                        Fill="{DynamicResource AccentBrush}"
                                        Style="{StaticResource PathIcon14Style}" />
                                </Border>
                            </Grid>
                            <CheckBox
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Content="打包成功的源文件移入回收站"
                                IsChecked="{Binding Settings.PackDelSource, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Expander>
        </Grid>
        <hui:DialogHost x:Name="MainDialogHost" Grid.RowSpan="2" />
    </Grid>
</hui:ChromeWindow>
